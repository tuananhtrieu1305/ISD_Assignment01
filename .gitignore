# Private local settings
.env
.env.*
!.env.example
.local/
.render-v3/

# Environments, package caches, and generated builds
**/.venv*/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.expo/
.uv-cache/
.ipython/
**/dist/
*.py[cod]
.DS_Store

# Data are downloaded/verified by registry; do not commit raw snapshots.
data/raw/
data/interim/
data/processed/*
!data/processed/v2/
data/processed/v2/*
!data/processed/v2/demos/

# New checkpoints are local; retain only the small active V2 demo bundle.
artifacts/models/*
!artifacts/models/v2/

# Rendered page QA and intermediate report builds are reproducible.
report/build/
report/qa*/
*.cover
.coverage*

# Compressed inventories are versioned; expanded CSVs are local audit products.
artifacts/manifests/phase20/*-files.csv
artifacts/manifests/phase20/keep-list-before.csv
artifacts/manifests/phase20/file-outcomes.csv
