{
  "version": 1,
  "subset_seed": 42,
  "model_seeds": [42, 52, 62],
  "frameworks": ["numpy", "keras", "pytorch"],
  "topology": {
    "cell": "vanilla_rnn_tanh",
    "hidden_size": 32,
    "recurrent_layers": 1,
    "head": "many_to_one"
  },
  "optimizer": "Adam",
  "learning_rate_candidates": [0.003, 0.001],
  "gradient_clip_norm": 1.0,
  "min_delta": 0.0001,
  "datasets": {
    "ch4_online_retail_customer_week": {
      "subset_sizes": {"train": 30000, "val": 8000, "test": 8000},
      "batch_size": 1024,
      "max_epochs": 15,
      "patience": 3,
      "class_weight": true
    },
    "ch4_aapl_next_close": {
      "batch_size": 128,
      "max_epochs": 30,
      "patience": 5,
      "class_weight": false
    }
  }
}
