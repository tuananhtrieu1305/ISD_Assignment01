    1:         self.assertAlmostEqual(result["probability"], float(expected["y_score"]), places=6)
    1:         self.assertEqual(result["predicted_class"], int(expected["y_pred"]))
    1:         self.assertIn("không phải chẩn đoán", result["warning"].lower())
       
