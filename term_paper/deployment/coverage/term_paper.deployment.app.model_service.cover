    1: def sha256_file(path):
   18:     digest = hashlib.sha256()
   36:     with Path(path).open("rb") as handle:
   72:         for chunk in iter(lambda: handle.read(1024 * 1024), b""):
   18:             digest.update(chunk)
   18:     return digest.hexdigest()
       
       
