    1: """Metrics derived from Chapter 3 prediction artifacts."""
       
    1: import numpy as np
    1: from sklearn.metrics import accuracy_score, precision_recall_fscore_support
       
       
    1: def multiclass_metrics(y_true, y_pred, labels):
    1:     y_true = np.asarray(y_true, dtype=int).reshape(-1)
    1:     y_pred = np.asarray(y_pred, dtype=int).reshape(-1)
    4:     labels = [int(value) for value in labels]
    2:     precision, recall, f1, support = precision_recall_fscore_support(
    1:         y_true, y_pred, labels=labels, zero_division=0
           )
    2:     macro_precision, macro_recall, macro_f1, _ = precision_recall_fscore_support(
    1:         y_true, y_pred, labels=labels, average="macro", zero_division=0
           )
    1:     result = {
    1:         "accuracy": float(accuracy_score(y_true, y_pred)),
    1:         "macro_precision": float(macro_precision),
    1:         "macro_recall": float(macro_recall),
    1:         "macro_f1": float(macro_f1),
           }
    4:     for index, label in enumerate(labels):
    3:         result[f"precision_class_{label}"] = float(precision[index])
    3:         result[f"recall_class_{label}"] = float(recall[index])
    3:         result[f"f1_class_{label}"] = float(f1[index])
    3:         result[f"support_class_{label}"] = int(support[index])
    1:     return result
