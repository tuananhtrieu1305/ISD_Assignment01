    1: def image_toy(seed=42):
           """Three easy image classes: vertical, horizontal and diagonal bars."""
    5:     rng = np.random.default_rng(seed)
    5:     images = []
    5:     labels = []
   20:     for label in range(3):
  285:         for _ in range(18):
  270:             image = rng.normal(0.0, 0.03, size=(8, 8, 1))
  270:             if label == 0:
   90:                 image[:, 1:3, 0] += 1.0
  180:             elif label == 1:
   90:                 image[5:7, :, 0] += 1.0
                   else:
   90:                 image[np.arange(8), np.arange(8), 0] += 1.0
  270:             images.append(image)
  270:             labels.append(label)
    5:     order = rng.permutation(len(images))
    5:     x = np.asarray(images, dtype=np.float32)[order]
    5:     y = np.asarray(labels, dtype=np.int64)[order]
    5:     return x[:42], y[:42], x[42:], y[42:]
       
       
    1: def sequence_toy(seed=42):
    2:     rng = np.random.default_rng(seed)
    2:     x = rng.normal(size=(15, 9, 1)).astype(np.float32)
    6:     y = np.argmax(
    2:         np.stack([x[:, :3].mean((1, 2)), x[:, 3:6].mean((1, 2)), x[:, 6:].mean((1, 2))], axis=1),
    2:         axis=1,
    2:     ).astype(np.int64)
    2:     return x, y
       
       
