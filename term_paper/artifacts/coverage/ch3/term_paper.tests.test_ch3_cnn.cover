    1:     def test_conv2d_numerical_gradient_matches_backpropagation(self):
    1:         x, y, _, _ = image_toy()
    1:         model = NumpyCNN((8, 8, 1), 3, mode="2d", filters=(2, 2), seed=42)
    1:         loss, gradients = model.loss_and_gradients(x[:3], y[:3])
    1:         self.assertTrue(np.isfinite(loss))
    1:         key, index, epsilon = "W1", (1, 1, 0, 0), 1e-5
    1:         original = float(model.params[key][index])
    1:         model.params[key][index] = original + epsilon
    1:         plus, _ = model.loss_and_gradients(x[:3], y[:3])
    1:         model.params[key][index] = original - epsilon
    1:         minus, _ = model.loss_and_gradients(x[:3], y[:3])
    1:         model.params[key][index] = original
    1:         numerical = (plus - minus) / (2 * epsilon)
    1:         self.assertAlmostEqual(float(gradients[key][index]), float(numerical), places=4)
       
