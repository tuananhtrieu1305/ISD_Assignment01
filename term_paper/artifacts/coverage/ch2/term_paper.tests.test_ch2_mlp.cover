    1:     def test_numerical_gradient_matches_backpropagation(self):
    1:         x_train, y_train, _, _ = binary_toy()
    1:         model = NumpyMLP(4, task="binary", hidden=(5, 3), seed=42, learning_rate=0.01)
    1:         _, gradients = model.loss_and_gradients(x_train[:8], y_train[:8])
    1:         key = "W3"
    1:         index = (1, 0)
    1:         original = float(model.params[key][index])
    1:         epsilon = 1e-5
    1:         model.params[key][index] = original + epsilon
    1:         loss_plus, _ = model.loss_and_gradients(x_train[:8], y_train[:8])
    1:         model.params[key][index] = original - epsilon
    1:         loss_minus, _ = model.loss_and_gradients(x_train[:8], y_train[:8])
    1:         model.params[key][index] = original
    1:         numerical = (loss_plus - loss_minus) / (2 * epsilon)
    1:         self.assertAlmostEqual(float(gradients[key][index]), float(numerical), places=4)
       
