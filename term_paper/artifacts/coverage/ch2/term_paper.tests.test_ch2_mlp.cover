    1: def binary_toy(seed=42):
    6:     rng = np.random.default_rng(seed)
    6:     negative = rng.normal(loc=-1.0, scale=0.35, size=(48, 4))
    6:     positive = rng.normal(loc=1.0, scale=0.35, size=(48, 4))
    6:     x = np.vstack([negative, positive]).astype(np.float32)
    6:     y = np.concatenate([np.zeros(48), np.ones(48)]).astype(np.float32)
    6:     order = rng.permutation(len(x))
    6:     return x[order[:72]], y[order[:72]], x[order[72:]], y[order[72:]]
       
       
    1: def regression_toy(seed=42):
    1:     rng = np.random.default_rng(seed)
    1:     x = rng.normal(size=(96, 3)).astype(np.float32)
    1:     y = (1.5 * x[:, 0] - 0.7 * x[:, 1] + 0.2 * x[:, 2]).astype(np.float32)
    1:     return x[:72], y[:72], x[72:], y[72:]
       
       
