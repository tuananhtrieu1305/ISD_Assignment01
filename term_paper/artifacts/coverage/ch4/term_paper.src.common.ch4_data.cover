       )
       
       
    1: WORKSPACE_ROOT = Path(__file__).resolve().parents[3]
    1: A06_ROOT = WORKSPACE_ROOT / "A06"
    1: PROCESSED_ROOT = A06_ROOT / "datasets" / "processed"
       
       
    1: def stratified_subset(labels, size, seed):
    5:     labels = np.asarray(labels, dtype=int).reshape(-1)
    5:     if int(size) <= 0 or int(size) > len(labels):
>>>>>>         raise ValueError("subset size must be within source split")
    5:     if int(size) == len(labels):
>>>>>>         return np.arange(len(labels), dtype=int)
   10:     selected, _ = train_test_split(
    5:         np.arange(len(labels)), train_size=int(size), random_state=int(seed), stratify=labels
           )
    5:     return np.asarray(sorted(selected), dtype=int)
       
       
    1: def class_weights(labels):
    2:     labels = np.asarray(labels, dtype=int).reshape(-1)
    2:     classes, counts = np.unique(labels, return_counts=True)
    2:     total = len(labels)
    6:     return {int(label): float(total / (len(classes) * count)) for label, count in zip(classes, counts)}
       
       
    1: def _customer_key(customer_id, target_week):
    9:     return np.asarray([
  500:         f"customer-{int(customer)}__week-{np.datetime_as_string(week, unit='D')}"
  506:         for customer, week in zip(customer_id, target_week)
           ])
       
       
    1: def prepare_customer_benchmark(subset_sizes, seed=42):
    1:     result = {}
    1:     keys, dates = {}, {}
    4:     for offset, split in enumerate(("train", "val", "test")):
    3:         source = np.load(PROCESSED_ROOT / f"customer_{split}.npz", allow_pickle=False)
    3:         chosen = stratified_subset(source["y"], int(subset_sizes[split]), int(seed) + offset)
    3:         result[f"x_{split}"] = source["X"][chosen].astype(np.float32)
    3:         result[f"y_{split}"] = source["y"][chosen].astype(np.float32)
    3:         dates[split] = source["target_week"][chosen].astype("datetime64[D]")
    3:         keys[split] = _customer_key(source["customer_id"][chosen], dates[split])
    1:     validate_temporal_splits(dates)
    1:     validate_split_keys(keys)
    2:     result.update({
    1:         "dataset_id": "ch4_online_retail_customer_week",
    1:         "task": "binary", "input_size": 5, "sequence_length": 8,
    1:         "keys": keys, "dates": dates,
    1:         "class_weight": class_weights(result["y_train"]),
    1:         "preprocessor_path": A06_ROOT / "models" / "preprocessing" / "customer_feature_scaler.joblib",
    1:         "split_sha256": split_digest(keys),
    1:         "source": "A06/datasets/processed/customer_{train,val,test}.npz",
           })
    1:     return result
       
       
    1: def prepare_stock_benchmark():
