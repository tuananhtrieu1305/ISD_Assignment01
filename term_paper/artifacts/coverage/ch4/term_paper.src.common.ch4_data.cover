    1: """Load read-only A06 arrays and construct the fixed Chapter 4 benchmark."""
       
    1: from pathlib import Path
       
    1: import joblib
    1: import numpy as np
    1: from sklearn.model_selection import train_test_split
       
    1: from term_paper.src.common.ch4_protocol import (
           split_digest,
