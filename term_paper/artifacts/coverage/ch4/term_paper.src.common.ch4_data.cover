    3:         result[f"naive_{split}"] = source["naive_last_close"].astype(np.float32)
    3:         dates[split] = source["target_date"].astype("datetime64[D]")
 2739:         keys[split] = np.asarray([np.datetime_as_string(value, unit="D") for value in dates[split]])
    1:     validate_temporal_splits(dates)
