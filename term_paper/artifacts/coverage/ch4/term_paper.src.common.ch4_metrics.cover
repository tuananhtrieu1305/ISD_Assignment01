    1: """Metrics and validation-only threshold selection for Chapter 4."""
       
    1: import numpy as np
    1: import pandas as pd
    1: from sklearn.metrics import (
           accuracy_score, average_precision_score, confusion_matrix, f1_score,
           mean_absolute_error, mean_squared_error, precision_score, r2_score,
           recall_score, roc_auc_score,
       )
       
       
    1: def binary_metrics(y_true, scores, threshold):
    4:     y_true = np.asarray(y_true, dtype=int).reshape(-1)
    4:     scores = np.asarray(scores, dtype=float).reshape(-1)
    4:     predicted = (scores >= float(threshold)).astype(int)
    4:     tn, fp, fn, tp = confusion_matrix(y_true, predicted, labels=[0, 1]).ravel()
    4:     return {
    4:         "accuracy": float(accuracy_score(y_true, predicted)),
    4:         "precision": float(precision_score(y_true, predicted, zero_division=0)),
    4:         "recall": float(recall_score(y_true, predicted, zero_division=0)),
    4:         "f1": float(f1_score(y_true, predicted, zero_division=0)),
    4:         "roc_auc": float(roc_auc_score(y_true, scores)),
    4:         "pr_auc": float(average_precision_score(y_true, scores)),
    4:         "tn": int(tn), "fp": int(fp), "fn": int(fn), "tp": int(tp),
           }
       
       
    1: def regression_metrics(y_true, prediction):
    1:     y_true = np.asarray(y_true, dtype=float).reshape(-1)
    1:     prediction = np.asarray(prediction, dtype=float).reshape(-1)
    1:     return {
    1:         "mae": float(mean_absolute_error(y_true, prediction)),
    1:         "rmse": float(np.sqrt(mean_squared_error(y_true, prediction))),
    1:         "r2": float(r2_score(y_true, prediction)),
           }
       
       
    1: def select_f1_threshold(y_true, scores, thresholds=None):
    1:     thresholds = np.asarray(thresholds if thresholds is not None else np.linspace(0.05, 0.95, 181))
    1:     rows = []
    4:     for threshold in thresholds:
    3:         metric = binary_metrics(y_true, scores, float(threshold))
    3:         rows.append({"threshold": float(threshold), "f1": metric["f1"], "precision": metric["precision"], "recall": metric["recall"]})
    1:     table = pd.DataFrame(rows)
    1:     best = table.sort_values(["f1", "threshold"], ascending=[False, True]).iloc[0]
    1:     return float(best["threshold"]), table
