    1: """Artifact helpers for the matched Chapter 4 RNN experiment."""
       
    1: import hashlib
    1: from pathlib import Path
       
    1: import numpy as np
    1: import pandas as pd
       
       
    1: def artifact_suffix(seed):
>>>>>>     return "" if int(seed) == 42 else f"_seed{int(seed)}"
       
       
    1: def sha256_file(path):
>>>>>>     digest = hashlib.sha256()
>>>>>>     with Path(path).open("rb") as handle:
>>>>>>         for chunk in iter(lambda: handle.read(1024 * 1024), b""):
>>>>>>             digest.update(chunk)
>>>>>>     return digest.hexdigest()
       
       
    1: def build_prediction_frame(dataset_id, framework, keys, y_true, prediction, seed, task,
