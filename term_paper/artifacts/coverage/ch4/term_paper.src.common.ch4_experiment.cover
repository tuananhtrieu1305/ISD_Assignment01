    1:         "split_sha256": split_sha256,
           })
    1:     if task == "binary":
>>>>>>         frame["threshold"] = float(threshold)
>>>>>>         frame["y_pred"] = (prediction >= float(threshold)).astype(int)
    1:     elif task == "regression":
    1:         frame["y_pred"] = prediction
    1:         if baseline is not None:
    1:             frame["naive_last_close"] = np.asarray(baseline, dtype=float)
           else:
>>>>>>         raise ValueError(task)
