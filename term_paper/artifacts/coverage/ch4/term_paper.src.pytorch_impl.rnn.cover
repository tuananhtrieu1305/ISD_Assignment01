    1:     def predict_score(self, x, batch_size=2048):
    2:         tensor = torch.as_tensor(np.asarray(x), dtype=torch.float32)
    2:         outputs = []
    2:         self.model.eval()
    4:         with torch.no_grad():
    4:             for start in range(0, len(tensor), int(batch_size)):
