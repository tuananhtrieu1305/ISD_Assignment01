            "properties": {
              "path": {
                "$ref": "urn:ai-paper:v3:common#/$defs/path"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "minItems": 0,
          "maxItems": 20
        },
        "input_sha256": {
          "$ref": "urn:ai-paper:v3:common#/$defs/sha256"
        }
