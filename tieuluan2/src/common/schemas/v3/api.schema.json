    "prediction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "classification"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "probabilities": {
              "type": "array",
