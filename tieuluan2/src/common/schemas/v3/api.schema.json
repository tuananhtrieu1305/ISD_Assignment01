        "implementation",
        "status",
        "model_id",
        "actual_device",
        "inference_ms",
        "artifact_sha256",
        "prediction",
        "error",
        "actual_backend",
        "input_sha256",
        "comparison_group_sha256"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
