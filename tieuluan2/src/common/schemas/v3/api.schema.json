    "agent_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
