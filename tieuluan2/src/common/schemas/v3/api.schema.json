        "family": {
          "enum": [
            "mlp",
            "cnn",
            "rnn",
            "lstm",
            "kg_rag",
            "multi_agent"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
