    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "poll_url": {
          "type": "string",
          "minLength": 1
