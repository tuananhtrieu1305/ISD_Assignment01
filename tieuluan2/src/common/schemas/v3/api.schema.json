                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              },
              "minItems": 2,
              "maxItems": 100
            }
          },
          "required": [
            "kind",
            "label",
            "probabilities"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "regression"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 24
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "horizons": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1,
              "maxItems": 24
            }
          },
          "required": [
            "kind",
            "values",
            "unit",
            "horizons"
          ]
