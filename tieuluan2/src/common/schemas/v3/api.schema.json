{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "chapter": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "family": {
      "enum": [
        "mlp",
        "cnn",
        "rnn",
        "lstm",
        "kg_rag",
        "multi_agent"
      ]
    },
    "implementations": {
      "oneOf": [
        {
          "const": [
            "scratch",
            "keras",
            "pytorch"
          ]
        },
        {
          "const": [
            "B0",
            "B1",
            "B2",
            "B3",
            "B4"
          ]
        },
        {
          "const": [
            "A0",
            "A1",
            "A2"
          ]
        }
      ]
    },
    "input": {
      "$ref": "urn:ai-paper:v3:common#/$defs/payload"
    }
  },
  "required": [
    "schema_version",
    "chapter",
    "dataset_id",
    "family",
    "implementations",
    "input"
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "3.0.0"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,95}$"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "code",
                  "message"
                ]
              },
              "minItems": 0,
              "maxItems": 30
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "error"
      ]
