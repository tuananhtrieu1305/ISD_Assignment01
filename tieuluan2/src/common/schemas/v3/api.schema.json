      "required": [
        "schema_version",
        "request_id",
        "job_id",
        "request_sha256",
        "status",
        "dataset_id",
        "family",
        "created_at",
        "expires_at",
        "results",
        "comparison_valid",
        "comparison_blockers",
        "trace_ids",
        "metric_artifacts",
        "input_sha256"
      ]
