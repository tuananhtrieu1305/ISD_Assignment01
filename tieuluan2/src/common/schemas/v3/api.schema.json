        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "answer"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "abstained": {
              "type": "boolean"
            },
            "citations": {
              "type": "array",
              "items": {
                "$ref": "urn:ai-paper:v3:common#/$defs/citation"
              },
              "minItems": 0,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "text",
            "abstained",
            "citations"
          ]
        }
      ]
