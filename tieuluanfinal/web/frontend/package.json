{
  "name": "ai-term-paper-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --config vitest.v3.config.ts",
    "test:coverage": "vitest run --config vitest.v3.config.ts --coverage",
    "test:legacy": "node --experimental-strip-types --test src/api/sequence.test.ts src/api/apiUrl.test.ts src/api/knowledgeApi.test.ts",
    "e2e": "playwright test --config playwright.v3.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "install:browsers": "playwright install chromium",
    "format:v3": "prettier --write src/v3 tests/v3 vite.config.ts vitest.v3.config.ts playwright.v3.config.ts eslint.config.mjs",
    "e2e:phase16": "node scripts/e2e_phase16.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/v3 --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "vitest": "5.0.5",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.9.2",
    "vite": "8.3.4"
  }
}
