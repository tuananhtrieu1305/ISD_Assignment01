{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "evidence_kind": {
      "enum": [
        "measured",
        "synthetic_fixture",
        "historical_baseline"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "split_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "split_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "git_commit",
        "dirty_tree_sha256"
      ]
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "urn:ai-paper:v3:common#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "implementation": {
      "$ref": "urn:ai-paper:v3:common#/$defs/implementation"
    },
    "backend": {
      "enum": [
        "numpy",
        "tensorflow",
        "torch"
      ]
    },
    "family": {
      "$ref": "urn:ai-paper:v3:common#/$defs/family"
    },
    "track": {
      "enum": [
        "full_data",
        "matched_subset"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "subset_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "split": {
      "enum": [
        "validation",
        "test"
      ]
    },
    "test_seal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "enum": [
        "cpu",
        "cuda:0"
      ]
    },
    "dtype": {
      "enum": [
        "float32",
        "float64"
      ]
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "min",
              "max"
            ]
          },
          "horizon": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "undefined_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "direction",
          "horizon",
          "undefined_reason"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train_seconds": {
          "type": "number",
          "minimum": 0
        },
        "inference_p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "inference_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "warmup_batches": {
          "type": "integer",
          "minimum": 0
        },
        "timed_repeats": {
          "type": "integer",
          "minimum": 1
        },
        "peak_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_vram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "train_seconds",
        "inference_p50_ms",
        "inference_p95_ms",
        "warmup_batches",
        "timed_repeats",
        "peak_ram_bytes",
        "peak_vram_bytes",
        "checkpoint_bytes"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "urn:ai-paper:v3:common#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 30
    },
    "dataset_sha256": {
      "$ref": "urn:ai-paper:v3:common#/$defs/sha256"
    },
    "comparison_group_sha256": {
      "$ref": "urn:ai-paper:v3:common#/$defs/sha256"
    },
    "protocol_sha256": {
      "$ref": "urn:ai-paper:v3:common#/$defs/sha256"
    },
    "preprocessing": {
      "$ref": "urn:ai-paper:v3:common#/$defs/artifact_ref"
    }
  },
  "required": [
    "schema_version",
    "evidence_kind",
    "run_id",
    "dataset_id",
    "split_id",
    "split_sha256",
    "config_sha256",
    "code",
    "environment_sha256",
    "model_contract",
    "implementation",
    "backend",
    "family",
    "track",
    "seed",
    "subset_sha256",
    "status",
    "split",
    "test_seal_id",
    "device",
    "dtype",
    "batch_size",
    "started_at",
    "finished_at",
    "metrics",
    "efficiency",
    "artifacts",
    "warnings",
    "dataset_sha256",
    "comparison_group_sha256",
    "protocol_sha256",
    "preprocessing"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-paper:v3:run",
  "title": "AI term paper V3 run contract"
}
