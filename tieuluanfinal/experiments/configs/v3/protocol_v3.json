{
  "schema_version": "3.0.0",
  "spec_id": "ai_v3_protocol_2026_10_17",
  "status": "locked_specification",
  "scope": "Prospective policy, not measured dataset sizes or trained-model results. Existing Ch5 protocol overrides this file for Ch5.",
  "implementation_order": [
    "scratch",
    "keras",
    "pytorch"
  ],
  "seeds": {
    "primary": 42,
    "stability": [
      17,
      42,
      73
    ],
    "required_comparison_track": "matched_subset",
    "single_seed_claim_policy": "No mean/std or superiority claim without completed multi-seed runs."
  },
  "families": {
    "mlp": {
      "chapter": 2,
      "implementation_phase": 26,
      "minimum_learnable_layers": 6,
      "blocks": [
        "dense",
        "dense",
        "dense",
        "dense",
        "dense",
        "dense"
      ],
      "hidden_units": [
        64,
        64,
        32,
        32,
        16
      ]
    },
    "cnn": {
      "chapter": 3,
      "implementation_phase": 27,
      "minimum_learnable_layers": 7,
      "blocks": [
        "conv2d",
        "conv2d",
        "conv2d",
        "conv2d",
        "conv2d",
        "dense",
        "dense"
      ],
      "channels": [
        8,
        8,
        16,
        16,
        32
      ],
      "dense_hidden": 32,
      "kernel_size": 3,
      "padding": "same",
      "pool_after_convolutions": [
        1,
        3
      ],
      "global_average_pool": true
    },
    "rnn": {
      "chapter": 4,
      "implementation_phase": 28,
      "minimum_learnable_layers": 6,
      "blocks": [
        "rnn",
        "rnn",
        "rnn",
        "dense",
        "dense",
        "dense"
      ],
      "hidden_units": [
        32,
        32,
        32
      ],
      "dense_hidden": [
        16,
        8
      ],
      "state_policy": "Reset between windows; return full sequence from first two recurrent layers."
    },
    "lstm": {
      "chapter": 4,
      "implementation_phase": 29,
      "minimum_learnable_layers": 6,
      "blocks": [
        "lstm",
        "lstm",
        "lstm",
        "dense",
        "dense",
        "dense"
      ],
      "hidden_units": [
        32,
        32,
        32
      ],
      "dense_hidden": [
        16,
        8
      ],
      "gate_order": [
        "input",
        "forget",
        "candidate",
        "output"
      ],
      "state_policy": "Reset h/c between windows; sigmoid gates, tanh candidate; single canonical bias, forget bias 1."
    }
  },
  "layer_policy": {
    "counted_kinds": [
      "dense",
      "conv1d",
      "conv2d",
      "rnn",
      "lstm"
    ],
    "excluded_kinds": [
      "input",
      "reshape",
      "activation",
      "pooling",
      "dropout",
      "normalization",
      "container",
      "time_step"
    ],
    "rule": "Count distinct parameterized logical layers, not recurrent time steps, gates, or containers; each counted layer must have trainable parameters."
  },
  "training": {
    "dtype": "float32",
    "optimizer": {
      "name": "adam",
      "learning_rate": 0.001,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-7,
      "epsilon_convention": "denominator sqrt(v_hat)+epsilon; adapters must normalize or disclose numerical deviations"
    },
    "max_epochs": 40,
    "patience": 6,
    "min_delta": 0.00001,
    "checkpoint_selection": "minimum validation loss; never TEST",
    "hyperparameter_search_trials": 1,
    "shuffle_policy": "Saved common train batch order per seed; no split/time shuffle.",
    "batch_size": {
      "mlp": 32,
      "cnn": 16,
      "rnn": 32,
      "lstm": 32
    },
    "gradient_clip_global_norm": 1,
    "initialization": "Generate canonical NumPy weights once per seed; convert layouts for each adapter; paired forward/gradient checks before training.",
    "wall_time_limit_minutes": 120,
    "failure_policy": "Record timeout/OOM/NaN as failed, never silently reduce samples, architecture or epochs for one implementation."
  },
  "comparison": {
    "main": "Three implementations on exactly the same matched train IDs, full validation IDs and full TEST IDs, same resolution/windows/config/seed.",
    "full_data": "Supplemental only unless all three complete the full-data track; never rank across tracks.",
    "matched_subset_selection": "After split, stable SHA-256 ordering seeded by 42 within class/group or series; all available train rows if below cap; save selected ID hash.",
    "training_runs_required": 108,
    "training_runs_formula": "4 families x 3 datasets x 3 implementations x 3 seeds; classical baselines and optional full-data runs are additional.",
    "recurrent_bias_policy": "One canonical learned bias per recurrent layer/gate; PyTorch second bias must be zero/frozen or deviation explicitly invalidates parameter-parity claims.",
    "numeric_parity": {
      "forward_rtol": 0.0001,
      "forward_atol": 0.00001,
      "gradient_relative_error": 0.001
    },
    "inference_timing": {
      "warmup_batches": 5,
      "repeats": 30,
      "batch_size": 1,
      "gpu_synchronize": true,
      "include_preprocessing_separately": true
    }
  },
  "split_policy": {
    "tabular": [
      0.7,
      0.15,
      0.15
    ],
    "temporal": "Global ordered target-time partitions; every forecast horizon target must lie within the same partition; context may precede validation/test boundary but never include future observations.",
    "official_test_preserved": true,
    "preprocessing_fit": "train only, including imputers, scaler, encoder, target transform and class weights",
    "duplicates": "Compute identity/hash before split; assign exact duplicate/group as one unit; do not inspect TEST metrics to adjust filters.",
    "rolling_validation": "Three expanding-window folds inside pre-TEST training/validation region; TEST remains sealed; preprocess fit independently per fold.",
    "test_policy": "Freeze split/config/code/evaluator and all approved seed/implementation run IDs before one authorized evaluation batch. Save each prediction/metric once. No seed/config selection by TEST."
  },
  "metrics": {
    "classification": {
      "primary": "macro_f1",
      "secondary": [
        "accuracy",
        "weighted_f1",
        "per_class_recall",
        "confusion_matrix",
        "auroc",
        "average_precision"
      ],
      "binary_threshold": 0.5,
      "undefined": "null with reason; no fabricated 0; AUROC/PR require valid class support"
    },
    "regression": {
      "primary": "rmse",
      "secondary": [
        "mae",
        "r2"
      ],
      "units": "original target units after inverse transform"
    },
    "forecast": {
      "primary": "rmse",
      "secondary": [
        "mae",
        "smape"
      ],
      "breakdown": [
        "horizon",
        "series"
      ],
      "zero_policy": "MAPE excluded when zeros/near-zeros; sMAPE zero/zero=0 declared; never average different target units"
    },
    "efficiency": [
      "train_seconds",
      "inference_p50_ms",
      "inference_p95_ms",
      "peak_ram_bytes",
      "peak_vram_bytes",
      "checkpoint_bytes",
      "parameter_count"
    ],
    "agent": [
      "task_success",
      "routing_accuracy",
      "numeric_parity",
      "citation_correctness",
      "unsupported_claim_rate",
      "refusal_correctness",
      "latency_ms",
      "message_count",
      "peak_ram_bytes"
    ]
  },
