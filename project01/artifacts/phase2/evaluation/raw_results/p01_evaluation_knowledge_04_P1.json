        {
          "chunk_id": "med-chunk-82590075a17e09710b4b",
          "document_id": "med-doc-b963a6d34976532de96d",
          "domain": "medical",
          "text": "A predisposition to develop type 1 diabetes is passed through generations in families, but the inheritance pattern is unknown.",
          "score": 0.012795158508297152,
          "source_url": "https://github.com/abachaa/MedQuAD/tree/577bd37b96c02d1833b2c9eed2de9f96964e96cb",
          "locator": "med-doc-b963a6d34976532de96d/med-chunk-82590075a17e09710b4b",
          "text_sha256": "68563f5f002c6fabc87efa4fceae021e335f63063d93f61d795e3d059360cf73",
          "source_sha256": "42f025f955852567436dc7cd7efde701ca014429f47dacae7d7c0ba23ab51f29",
          "graph_path": [
            "kg-node-e4478973683fc0dc1746cc46",
