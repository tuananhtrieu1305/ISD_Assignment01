        {
          "chunk_id": "med-chunk-322cf32545ba0d9fccd3",
          "document_id": "med-doc-f11464e25c55c54923c9",
          "domain": "medical",
          "text": "including insulin resistance, a condition in which the bodys muscle, fat, and liver cells do not use insulin effectively. Type 2 diabetes develops when the body can no longer produce enough insulin to compensate for the impaired ability to use insulin. Get more details about who should be tested for diabetes.",
          "score": 0.015433277820311453,
          "source_url": "https://github.com/abachaa/MedQuAD/tree/577bd37b96c02d1833b2c9eed2de9f96964e96cb",
          "locator": "med-doc-f11464e25c55c54923c9/med-chunk-322cf32545ba0d9fccd3",
          "text_sha256": "fcad9c71cbf770cb507f7e412d35445f26b2288442c64b1a992c8a7644b89bb0",
          "source_sha256": "42f025f955852567436dc7cd7efde701ca014429f47dacae7d7c0ba23ab51f29",
          "graph_path": [
            "kg-node-fcb21efed59ffe4ef1ceac5c",
