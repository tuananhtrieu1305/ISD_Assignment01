{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase25 tensor adapter sidecar (extends, does not modify Phase22)",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_version", "dataset_id", "fold", "kind", "dtype", "feature_order_policy", "output_feature_names", "class_names", "source_label_to_id", "class_weights_by_id", "canonical_layout", "pytorch_image_layout", "preprocessing"],
  "properties": {
    "adapter_version": {"const": "phase25.1"},
    "dataset_id": {"type": "string", "pattern": "^ch[234]_[a-z0-9_]+$"},
    "fold": {"enum": [null, 1, 2, 3]},
    "kind": {"enum": ["tabular", "image", "timeseries"]},
    "dtype": {"const": "float32"},
    "feature_order_policy": {"type": "string", "minLength": 1},
    "output_feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "class_names": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_label_to_id": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "class_weights_by_id": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "canonical_layout": {"enum": ["NF", "NHWC", "NTF"]},
    "pytorch_image_layout": {"enum": [null, "NCHW"]},
    "preprocessing": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "pattern": "^(artifacts|data)/[A-Za-z0-9_./-]+$"},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }}
  }
}
